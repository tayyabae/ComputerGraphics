void leftside() {
	glBegin(GL_POLYGON);
	glColor3f(0.0, 0.7, 1.0);
	glVertex2i(0, 600);
	glVertex2i(500, 600);
	glVertex2i(500, 0);
	glVertex2i(0, 0);
	glEnd();
	pond();
	bench();
	tree();
	swing();
}
void transformedside() {
	glBegin(GL_POLYGON);
	glColor3f(0.6, 0.8, 1.0);
	glVertex2i(500, 600);
	glVertex2i(1000, 600);
	glVertex2i(1000, 0);
	glVertex2i(500, 0);
	glEnd();

	//pond 
	glPushMatrix();
	glTranslatef(500.0, 0.0, 0.0);
	pond();
	glPopMatrix();

	//swing 
	glPushMatrix();
	glTranslatef(150.0, 40.0, 0.0);
	glScalef(1.0, 1.1, 1.0);
	swing();
	glPopMatrix();

	//bench 
	glPushMatrix();
	glTranslatef(530.0, 0.0, 0.0);
	glScalef(1.1, 1.1, 1.0);
	bench();
	glPopMatrix();

	//tree 
	glPushMatrix();
	glTranslatef(870.0, 50.0, 0.0);
	tree();
	glPopMatrix();
}

void mydisplay() {
	glClear(GL_COLOR_BUFFER_BIT);
	leftside();
	transformedside();
	glFlush();
}
int main(int argc, char* argv[]) {
	glutInit(&argc, argv);
	glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
	glutInitWindowSize(1000, 600);
	glutInitWindowPosition(150, 100);
	glutCreateWindow("Assignment 2");
	glutDisplayFunc(mydisplay);
	MyInit();
	glutMainLoop();
}
