#include <iostream> 
#include <Windows.h> 
#include <gl/Gl.h> 
#include <gl/glut.h> 
void MyInit() {
	glClearColor(1.0, 1.0, 1.0, 1.0);
	glColor3f(1.0, 0.0, 0.0);
	glPointSize(4.0);
	glMatrixMode(GL_PROJECTION);
	glLoadIdentity();
	gluOrtho2D(0.0, 1000.0, 0.0, 600.0);
}
void pond() {
	glBegin(GL_POLYGON);
	glColor3f(0.0, 0.0, 2.0);
	glVertex2i(0, 100);
	glVertex2i(500, 200);
	glVertex2i(500, 0);
	glVertex2i(0, 0);
	glEnd();
}
